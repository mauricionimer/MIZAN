# Copie para .env e preencha. O .env real não entra no git.
# Em produção, esta variável é configurada no painel da Vercel
# (Settings → Environment Variables), não neste arquivo.
#
# O frontend fala só com o backend; quem acessa o Supabase é o backend,
# com a service role key. Por isso não há VITE_SUPABASE_* aqui.

VITE_API_URL=http://127.0.0.1:8001
